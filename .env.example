# Nusxa oling: cp .env.example backend/.env  (haqiqiy kalitlarni repoga qo'shmang!)
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DEMO_MODE=true

# SMS: console (bepul, kod logga yoziladi) | eskiz
SMS_BACKEND=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# To'lovlar (test kalitlari provayderlardan olinadi)
PAYMENT_PROVIDERS=payme,click,uzum
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_SERVICE_ID=
UZUM_LOGIN=
UZUM_PASSWORD=

# Gemini (AI tovar kartochkalari) — Google AI Studio kaliti
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
